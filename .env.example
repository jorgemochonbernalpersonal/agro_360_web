APP_NAME="Agro365"
APP_ENV=production              # local | production
APP_KEY=
FOUNDER_CODE=                   # Código secreto para el programa de fundadores (50 plazas, 12 meses beta)
APP_DEBUG=false                 # NUNCA true en producción — expone stack traces y variables de entorno
APP_TIMEZONE=Europe/Madrid
APP_URL=https://tudominio.com   # HTTPS obligatorio

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning               # debug solo en local — en producción loguea queries SQL y datos sensibles

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=agro365
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true           # false solo en local para desarrollo
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true     # false solo en local (requiere HTTPS en producción)

CACHE_STORE=database           # database o redis — NO usar array (el RateLimiter no persiste)
CACHE_PREFIX=agro365

QUEUE_CONNECTION=database

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=\hello@example.com\
MAIL_FROM_NAME=\\

# ── CORS ───────────────────────────────────────────────────────────────────────
# En producción poner el dominio exacto. NUNCA dejar * en producción.
# Para app móvil (sin origen web) puedes usar el dominio de la API misma.
CORS_ALLOWED_ORIGINS=https://tudominio.com

RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

SENTRY_LARAVEL_DSN=
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=
NASA_EARTHDATA_API_URL=https://appeears.earthdatacloud.nasa.gov/api

# ── VeriFactu / SIF (AEAT) ─────────────────────────────────────────────────────
SIF_ENVIRONMENT=testing
# production | testing  — en "testing" no se firma ni se envía a la AEAT real
SIF_AEAT_ENDPOINT=https://prewww1.aeat.es/wlpl/TIKE-CONT/ws/SistemaFacturacion/VerifactuSOAP
# En producción: https://www1.agenciatributaria.gob.es/wlpl/TIKE-CONT/ws/SistemaFacturacion/VerifactuSOAP
SIF_AEAT_WSDL=
# Ruta absoluta al fichero SistemaFacturacion.wsdl (solo producción)
# El certificado de firma NO se configura aquí: cada usuario sube el suyo
# propio en Ajustes → Datos Fiscales (ver App\Services\VerifactuCertificateService).
# ── Software identificador (del desarrollador del SIF) ──────────────────────────
SIF_VENDOR_NAME=Agro365
SIF_VENDOR_NIF=
SIF_SOFTWARE_NAME=Agro365
SIF_SOFTWARE_ID=A3
SIF_SOFTWARE_VERSION=1.0.0
SIF_INSTALL_ID=AGR001

# ── API / Sanctum (tokens móvil) ───────────────────────────────────────────────
SANCTUM_TOKEN_EXPIRATION=10080   # minutos — 10080 = 7 días. 43200 = 30 días (inseguro). 1440 = 1 día
SANCTUM_STATEFUL_DOMAINS=tudominio.com  # en local: localhost,127.0.0.1
SANCTUM_TOKEN_PREFIX=

# ── Redis (recomendado en producción — reemplaza CACHE_STORE=database) ──────────
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Google OAuth
# Client ID: usado por móvil (id_token) y web (Socialite redirect)
# Client Secret + Redirect: solo necesarios para el flujo web (Socialite)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://tudominio.com/auth/google/callback
