APP_NAME=\ Agro365\
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Madrid
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=agro365
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
CACHE_PREFIX=agro365

QUEUE_CONNECTION=database

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=\hello@example.com\
MAIL_FROM_NAME=\\

RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

SENTRY_LARAVEL_DSN=
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=
NASA_EARTHDATA_API_URL=https://appeears.earthdatacloud.nasa.gov/api

# ── VeriFactu / SIF (AEAT) ─────────────────────────────────────────────────────
SIF_ENVIRONMENT=testing
# production | testing  — en "testing" no se firma ni se envía a la AEAT real
SIF_AEAT_ENDPOINT=https://prewww1.aeat.es/wlpl/TIKE-CONT/ws/SistemaFacturacion/VerifactuSOAP
# En producción: https://www1.agenciatributaria.gob.es/wlpl/TIKE-CONT/ws/SistemaFacturacion/VerifactuSOAP
SIF_AEAT_WSDL=
# Ruta absoluta al fichero SistemaFacturacion.wsdl (solo producción)
SIF_CERT_PATH=
SIF_CERT_PASSWORD=
# ── Software identificador (del desarrollador del SIF) ──────────────────────────
SIF_VENDOR_NAME=Agro365
SIF_VENDOR_NIF=
SIF_SOFTWARE_NAME=Agro365
SIF_SOFTWARE_ID=A3
SIF_SOFTWARE_VERSION=1.0.0
SIF_INSTALL_ID=AGR001
