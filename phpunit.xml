<?xml version="1.0" encoding="UTF-8"?>
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
    bootstrap="tests/bootstrap.php"
    colors="true"
    cacheDirectory=".phpunit.cache"
    stopOnFailure="false"
    executionOrder="default"
    failOnRisky="false"
    beStrictAboutTestsThatDoNotTestAnything="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">./tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory suffix="Test.php">./tests/Feature</directory>
            <!-- Api/ vive bajo Feature/; se expone como suite propia abajo.
                 Se excluye aquí para no añadir los mismos ficheros dos veces. -->
            <exclude>./tests/Feature/Api</exclude>
        </testsuite>
        <testsuite name="Api">
            <directory suffix="Test.php">./tests/Feature/Api</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory suffix=".php">./app</directory>
        </include>
    </source>

    <php>
        <ini name="memory_limit" value="-1"/>
        <!-- Laravel loads .env.testing when APP_ENV=testing (no DB vars = use .env.testing) -->
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:2fl+Ktvkujt7GgAsMohK/Vw9HdtcfVGMGmqPzJmMKj8="/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_DRIVER" value="array"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
